{
  "name": "@adraw/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "core:build": "pnpm --filter core build",
    "react:build": "pnpm --filter react build",
    "vue:build": "pnpm --filter vue build",
    "svelte:build": "pnpm --filter svelte build",
    "solid:build": "pnpm --filter solid build",
    "angular:build": "pnpm --filter angular build",
    "web-components:build": "pnpm --filter web-components build",
    "web:build": "pnpm core:build && pnpm --filter web build",
    "dev": "pnpm -r --parallel dev",
    "core:dev": "pnpm --filter core dev",
    "react:dev": "pnpm --filter react dev",
    "vue:dev": "pnpm --filter vue dev",
    "svelte:dev": "pnpm --filter svelte dev",
    "solid:dev": "pnpm --filter solid dev",
    "angular:dev": "pnpm --filter angular dev",
    "web-components:dev": "pnpm --filter web-components dev",
    "web:dev": "pnpm --filter web dev",
    "ci:version": "changeset version",
    "ci:release": "pnpm install && pnpm build && npm login && pnpm core:release && changeset publish && git push origin main --tags",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "(oxlint --fix || true) && oxfmt",
    "lint:github": "oxlint --format=github",
    "core:release": "pnpm --filter core publish --access public --no-git-checks && git tag \"@adraw/core@$(node -p 'JSON.parse(require(\"fs\").readFileSync(\"packages/core/package.json\", \"utf8\")).version')\"",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "happy-dom": "^20.10.6",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsdown": "0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@12.14.0"
}
