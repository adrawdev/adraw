---
import {
  CircleIcon,
  ClipboardPasteIcon,
  CopyIcon,
  EraserIcon,
  HandIcon,
  ImageIcon,
  ImageDownIcon,
  MinusIcon,
  MousePointerIcon,
  MoveUpRightIcon,
  PencilIcon,
  PlusIcon,
  RatioIcon,
  RedoIcon,
  ScissorsIcon,
  SquareIcon,
  TypeIcon,
  UndoIcon
} from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div">;

const { class: className, ...props } = Astro.props;
---

<div class:list={["canvas-root", className]} {...props}>
  <div class="toolbar">
    <button class="tool-button" data-tool="select" title="Select (V)" aria-pressed="true">
      <MousePointerIcon size={16} />
    </button>
    <button class="tool-button" data-tool="hand" title="Hand (H)">
      <HandIcon size={16} />
    </button>
    <button class="tool-button" data-tool="rectangle" title="Rectangle (R)">
      <SquareIcon size={16} />
    </button>
    <button class="tool-button" data-tool="ellipse" title="Ellipse (E)">
      <CircleIcon size={16} />
    </button>
    <button class="tool-button" data-tool="draw" title="Draw (D)">
      <PencilIcon size={16} />
    </button>
    <button class="tool-button" data-tool="line" title="Line (L)">
      <MinusIcon size={16} />
    </button>
    <button class="tool-button" data-tool="arrow" title="Arrow (A)">
      <MoveUpRightIcon size={16} />
    </button>
    <button class="tool-button" data-tool="text" title="Text (T)">
      <TypeIcon size={16} />
    </button>
    <button class="tool-button" data-tool="eraser" title="Eraser (E)">
      <EraserIcon size={16} />
    </button>
    <button class="tool-button" data-action="insert-media" title="Insert image">
      <ImageIcon size={16} />
    </button>
    <div class="separator"></div>
    <button class="tool-button" data-action="undo" title="Undo (Ctrl+Z)">
      <UndoIcon size={16} />
    </button>
    <button class="tool-button" data-action="redo" title="Redo (Ctrl+Shift+Z)">
      <RedoIcon size={16} />
    </button>
    <div class="separator"></div>
    <button class="tool-button" data-action="copy" title="Copy (Ctrl+C)">
      <CopyIcon size={16} />
    </button>
    <button class="tool-button" data-action="cut" title="Cut (Ctrl+X)">
      <ScissorsIcon size={16} />
    </button>
    <button class="tool-button" data-action="paste" title="Paste (Ctrl+V)">
      <ClipboardPasteIcon size={16} />
    </button>
    <div class="separator"></div>
    <button class="tool-button" data-action="zoom-in" title="Zoom In">
      <PlusIcon size={16} />
    </button>
    <button class="tool-button zoom-reset" data-action="reset" title="Reset">100%</button>
    <button class="tool-button" data-action="zoom-out" title="Zoom Out">
      <MinusIcon size={16} />
    </button>
    <button class="tool-button" data-action="zoom-fit" title="Zoom to Fit">
      <RatioIcon size={16} />
    </button>
    <button class="tool-button" data-action="export" title="Export to image">
      <ImageDownIcon size={16} />
    </button>
    <input id="file-input" type="file" accept="image/*" hidden multiple />
  </div>
  <div class="color-palette">
    <button data-action="change-color" data-color="var(--adraw-stroke)" class="swatch" style="--swatch: var(--adraw-stroke)"></button>
    <button data-action="change-color" data-color="#f22" class="swatch swatch-bordered" style="--swatch: #f22"></button>
    <button data-action="change-color" data-color="#8f8" class="swatch swatch-bordered" style="--swatch: #8f8"></button>
    <button data-action="change-color" data-color="#08f" class="swatch swatch-bordered" style="--swatch: #08f"></button>
    <button data-action="change-color" data-color="#ff0" class="swatch swatch-bordered" style="--swatch: #ff0"></button>
    <button data-action="change-color" data-color="#0ff" class="swatch swatch-bordered" style="--swatch: #0ff"></button>
    <button data-action="change-color" data-color="#f0f" class="swatch swatch-bordered" style="--swatch: #f0f"></button>
    <button data-action="change-color" data-color="#fa0" class="swatch swatch-bordered" style="--swatch: #fa0"></button>
  </div>
  <div class="canvas-container"></div>
</div>

<style>
  .canvas-root {
    position: relative;
  }
  .toolbar {
    position: absolute;
    top: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    width: fit-content;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    box-shadow:
      0 10px 15px -3px color-mix(in oklab, black 5%, transparent),
      0 4px 6px -4px color-mix(in oklab, black 5%, transparent);
  }
  .tool-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    &:hover {
      background: color-mix(in oklab, var(--color-primary) 10%, transparent);
    }
    &:active {
      border-color: var(--color-border);
    }
    &[aria-pressed="true"] {
      background: color-mix(in oklab, var(--color-primary) 20%, transparent);
      color: var(--color-primary);
    }
  }
  .zoom-reset {
    width: 4rem;
    height: 2.5rem;
    font-variant-numeric: tabular-nums;
  }
  .separator {
    width: 1px;
    height: 1.5rem;
    background: var(--color-border);
  }
  .color-palette {
    position: absolute;
    top: 4rem;
    right: 0.5rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    box-shadow:
      0 10px 15px -3px color-mix(in oklab, black 5%, transparent),
      0 4px 6px -4px color-mix(in oklab, black 5%, transparent);
  }
  .swatch {
    width: 1rem;
    height: 1rem;
    border-radius: 0.375rem;
    background: var(--swatch);
  }
  .swatch-bordered {
    border: 1px solid var(--color-border);
  }
  .canvas-container {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { AdrawCanvas, type MediaInput, type ToolType } from '@adraw/core'

  const toolbar = document.querySelector<HTMLDivElement>(".toolbar")!

  const canvasContainer = document.querySelector<HTMLDivElement>(".canvas-container")!

  const canvas = new AdrawCanvas({
    container: canvasContainer,
  })

  canvas.on("viewportChange", (ev) => {
    document.querySelector<HTMLButtonElement>(`[data-action="reset"]`)!.textContent = `${Math.floor(ev.viewport.zoom * 100)}%`
  })

  canvas.on("toolChange", (ev) => {
    updateToolbar()
  })

  const buttons = toolbar.querySelectorAll<HTMLButtonElement>("[data-tool]")
  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tool = btn.dataset.tool as ToolType
      canvas.setActiveTool(tool)
      updateToolbar()
    })
  })

  // Media insertion
  const fileInput = document.getElementById("file-input") as HTMLInputElement

  fileInput.addEventListener("change", async () => {
    const files = fileInput.files
    if (!files || files.length === 0) {
      return
    }

    const descriptors: MediaInput[] = await Promise.all(
      Array.from(files, async (file) => {
        const dataUrl = await readFileAsDataURL(file)
        const img = await getImageFromSrc(dataUrl)
        return {
          mimeType: file.type,
          naturalHeight: img.naturalHeight,
          naturalWidth: img.naturalWidth,
          src: dataUrl,
        }
      }),
    )

    if (descriptors.length > 0) {
      canvas.insertMedia(descriptors)
    }

    fileInput.value = ""
  })

  const readFileAsDataURL = (file: File | Blob) =>
    new Promise<string>((resolve, reject) => {
      const reader = new FileReader()
      reader.readAsDataURL(file)
      reader.addEventListener("load", (ev) => {
        if (ev.target?.readyState === FileReader.DONE) {
          resolve(ev.target.result as string)
        } else {
          reject(new Error("Failed to load file."))
        }
      })
      reader.addEventListener("error", reject)
    })

  const getImageFromSrc = (src: string) =>
    new Promise<HTMLImageElement>((resolve, reject) => {
      const img = new Image()
      img.onload = () => resolve(img)
      img.onerror = reject
      img.src = src
    })

  const actionButtons =
    document.querySelectorAll<HTMLButtonElement>("[data-action]")
  actionButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const {action} = btn.dataset
      switch (action) {
        case "insert-media": {
          fileInput.click()
          break
        }
        case "change-color": {
          const {color} = btn.dataset
          canvas.setStrokeColor(color!)
          break
        }
        case "export": {
          exportImage()
          break
        }
        case "undo": {
          canvas.undo()
          break
        }
        case "redo": {
          canvas.redo()
          break
        }
        case "copy": {
          canvas.copy()
          break
        }
        case "cut": {
          canvas.cut()
          break
        }
        case "paste": {
          canvas.paste()
          break
        }
        case "zoom-in": {
          canvas.zoomIn()
          break
        }
        case "zoom-out": {
          canvas.zoomOut()
          break
        }
        case "zoom-fit": {
          canvas.zoomToFit()
          break
        }
        case "reset": {
          canvas.resetZoom()
          break
        }
      }
    })
  })

  function updateToolbar() {
    const activeTool = canvas.getActiveTool()
    buttons.forEach((btn) => {
      btn.ariaPressed = btn.dataset.tool === activeTool ? "true" : null
    })
  }

  async function exportImage() {
    const format = "png";
    const blob = await canvas.toImage({ format });
    downloadFile(blob, `adraw-${Date.now()}.${format}`);
  }

  async function downloadFile(data: Blob, fileName: string) {
    const url = await readFileAsDataURL(data)
    const a = document.createElement("a")
    a.href = url
    a.download = fileName
    document.body.appendChild(a)
    a.style = "display:none"
    a.click()
    a.remove()
  }

  updateToolbar()
</script>
