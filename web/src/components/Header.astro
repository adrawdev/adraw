---
import Logo from "../assets/logo.svg"
import { LaptopMinimal, Moon, Sun } from "@lucide/astro"

const themes = [
  { icon: LaptopMinimal, label: "System", name: "system" },
  { icon: Sun, label: "Light", name: "light" },
  { icon: Moon, label: "Dark", name: "dark" },
]
---

<div class="site-header">
  <a class="logo-link" href="/">
    <Logo />
    <h1>adraw</h1>
  </a>
  <ul class="nav-list">
    <li><a href="/docs/core">Docs</a></li>
    <li><a href="/examples">Examples</a></li>
    <li class="theme-switcher">
      {themes.map((theme) => (
        <label class="theme-option" title={theme.label}>
          <input
            type="radio"
            class="visually-hidden"
            name="theme"
            value={theme.name}
          />
          <theme.icon size={16} />
        </label>
      ))}
    </li>
  </ul>
</div>

<script>
  import { updateTheme } from "@/utils/theme";

  document.addEventListener('DOMContentLoaded', () => {
    const theme = localStorage.theme || "system";
    document.querySelectorAll<HTMLInputElement>("input[name=theme]").forEach((el) => {
      const { value } = el;
      if (theme === value) {el.setAttribute("checked", "");}
      el.addEventListener("change", () => {
        localStorage.theme = value;
        updateTheme();
      });
    });
  })
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 1.5rem;
    height: 4.5rem;
  }
  .logo-link {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    svg {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .theme-switcher {
    display: flex;
  }
  .theme-option {
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.375rem;
    &:hover {
      background: color-mix(in oklab, var(--color-primary) 10%, transparent);
    }
    &:has(:checked) {
      background: var(--color-primary);
      color: var(--color-background);
    }
  }
</style>