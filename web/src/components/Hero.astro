---
import Canvas from "./Canvas.astro";
---

<section class="hero">
  <div class="hero-copy">
    <h2>A framework-agnostic infinity canvas</h2>
    <a
      class="hero-cta"
      href="/docs/core">Getting started</a
    >
  </div>
  <div class="hero-canvas-wrap">
    <Canvas class="hero-canvas" />
  </div>
</section>

<style>
  .hero {
    padding: 1.5rem;
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    justify-content: center;
    gap: 2rem;
    @media (min-width: 64rem) {
      grid-template-columns: 24rem minmax(0, 1fr);
    }
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    h2 {
      text-align: center;
      font-size: 2.25rem;
      line-height: calc(2.5 / 2.25);
      text-wrap: balance;
    }
    @media (min-width: 64rem) {
      align-items: flex-end;
      h2 {
        text-align: right;
      }
    }
  }
  .hero-cta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    height: 3rem;
    border-radius: 0.375rem;
    padding-inline: 1.25rem;
    background: var(--color-primary);
    color: var(--color-primary-foreground);
    font-weight: 600;
  }
  .hero-canvas-wrap {
    width: 100%;
  }
  :global(.hero-canvas) {
    height: calc(100dvh - 7.5rem);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
  }
</style>
