---
import JavaScriptIcon from "@/assets/javascript.svg";
import ReactIcon from "@/assets/react.svg";
import VueIcon from "@/assets/vue.svg";
import SvelteIcon from "@/assets/svelte.svg";
import SolidIcon from "@/assets/solidjs.svg";
import AngularIcon from "@/assets/angular.svg";
import WebComponentsIcon from "@/assets/webcomponents.svg";

const frameworks = [
  { icon: JavaScriptIcon, name: "core", title: "Vanilla" },
  { icon: ReactIcon, name: "react", title: "React" },
  { icon: VueIcon, name: "vue", title: "Vue" },
  { icon: SvelteIcon, name: "svelte", title: "Svelte" },
  { icon: SolidIcon, name: "solid", title: "Solid" },
  { icon: AngularIcon, name: "angular", title: "Angular" },
  { icon: WebComponentsIcon, name: "web-components", title: "Web Components" },
]
---
<aside class="docs-sidebar">
  <ul class="docs-nav">
    {frameworks.map((f) => (
      <li>
        <a href={`/docs/${f.name}`} aria-current={Astro.url.pathname == `/docs/${f.name}` ? "page" : undefined} class="docs-nav-link">
          <f.icon width="24" height="24" /> {f.title}
        </a>
      </li>
    ))}
    <li>
      <a href="/docs/agents" aria-current={Astro.url.pathname == "/docs/agents" ? "page" : undefined} class="docs-nav-link">
        <span class="docs-nav-icon">AI</span> Agent guide
      </a>
    </li>
    <li>
      <a href="/llms.txt" class="docs-nav-link">
        <span class="docs-nav-icon">llms</span> llms.txt
      </a>
    </li>
  </ul>
</aside>

<style>
  .docs-sidebar {
    padding: 1.5rem;
  }
  .docs-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .docs-nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    border-radius: 0.75rem;
    &:hover {
      background: color-mix(in oklab, var(--color-primary) 10%, transparent);
    }
    &[aria-current="page"] {
      background: var(--color-primary);
      color: var(--color-background);
    }
  }
  .docs-nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: color-mix(in oklab, var(--color-primary) 12%, transparent);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
</style>